# ELLY Maps backend configuration.
# Copy to `.env` and fill in real values. `.env` is git-ignored.

ENVIRONMENT=development

# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
# Development only. Allows Expo through localhost, LAN, Tailscale IP, or
# MagicDNS on the two supported dev-server ports. Production ignores it.
CORS_ORIGIN_REGEX=^https?://[^/]+:(?:8081|5173)$

# Maps & location providers (see reference/SPECIFICATION.md).
GOOGLE_MAPS_API_KEY=
MAPBOX_TOKEN=

# Data stores.
DATABASE_URL=postgresql://elly:elly@localhost:5432/elly_maps
REDIS_URL=redis://localhost:6379/0

# ELLY AI Travel Assistant (LLM provider).
ANTHROPIC_API_KEY=
